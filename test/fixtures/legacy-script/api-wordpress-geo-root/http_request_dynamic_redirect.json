[
  {
    "ref": "cf_security_https",
    "description": "Security setup: HTTP to HTTPS",
    "action": "redirect",
    "enabled": true,
    "expression": "(not ssl)",
    "action_parameters": {
      "from_value": {
        "status_code": 301,
        "preserve_query_string": true,
        "target_url": {
          "expression": "concat(\"https://\", http.host, http.request.uri.path)"
        }
      }
    }
  },
  {
    "ref": "cf_security_canonical_host",
    "description": "Security setup: www to non-www",
    "action": "redirect",
    "enabled": true,
    "expression": "(http.host eq \"www.example.com\")",
    "action_parameters": {
      "from_value": {
        "status_code": 301,
        "preserve_query_string": true,
        "target_url": {
          "expression": "concat(\"https://example.com\", http.request.uri.path)"
        }
      }
    }
  }
]
